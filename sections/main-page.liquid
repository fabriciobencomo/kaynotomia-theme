<div style="max-width:800px;margin:120px auto;padding:0 40px 80px;color:var(--text);">
  <h1 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;letter-spacing:.16em;text-transform:uppercase;margin-bottom:32px;color:var(--text);">{{ page.title }}</h1>
  <div style="font-size:15px;font-weight:300;line-height:2;color:var(--text-light);letter-spacing:.03em;">{{ page.content }}</div>
</div>
{% schema %}{"name":"Page content","presets":[{"name":"Page content"}]}{% endschema %}
