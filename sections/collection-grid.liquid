{% comment %} sections/collection-grid.liquid {% endcomment %}
<section id="collections" class="py-24 lg:py-36" style="background:var(--bg-subtle);">
  <div class="max-w-screen-2xl mx-auto px-6 lg:px-14">
    <div class="text-center mb-16 reveal">
      <span class="section-label block mb-5">{{ section.settings.eyebrow | default: 'Colecciones' }}</span>
      <h2 class="section-title" style="font-size:clamp(2rem,4vw,3.2rem);font-weight:300;">{{ section.settings.heading | default: 'Nuestra Línea' }}</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {%- assign col = collections[section.settings.collection] -%}
      {%- if col != blank -%}
        {%- for product in col.products -%}
          {%- if section.settings.show_variants and product.variants.size > 1 -%}
            {%- comment -%}— Un card por variante —{%- endcomment -%}
            {%- for variant in product.variants -%}
              {%- assign card_img = variant.featured_image | default: product.featured_image -%}
              <div class="reveal group cursor-pointer" style="animation-delay:{{ forloop.index0 | times: 0.15 }}s;">
                <a href="{{ product.url }}?variant={{ variant.id }}" style="text-decoration:none;">
                  <div class="image-hover-zoom mb-5 aspect-[3/4]" style="background:var(--bg-mid);">
                    {%- if card_img -%}
                      <img src="{{ card_img | img_url: '800x' }}"
                           srcset="{{ card_img | img_url: '400x' }} 400w, {{ card_img | img_url: '800x' }} 800w"
                           sizes="(max-width:768px) 100vw, 33vw"
                           alt="{{ card_img.alt | default: variant.title | escape }}"
                           width="{{ card_img.width }}" height="{{ card_img.height }}"
                           class="w-full h-full object-cover" loading="lazy">
                    {%- endif -%}
                  </div>
                  <h3 class="product-name mb-2 group-hover:opacity-50 transition-opacity">{{ variant.title }}</h3>
                  <p class="collection-label">{{ variant.price | money }}</p>
                </a>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%}— Un card por producto (comportamiento por defecto) —{%- endcomment -%}
            <div class="reveal group cursor-pointer" style="animation-delay:{{ forloop.index0 | times: 0.15 }}s;">
              <a href="{{ product.url }}" style="text-decoration:none;">
                <div class="image-hover-zoom mb-5 aspect-[3/4]" style="background:var(--bg-mid);">
                  {%- if product.featured_image -%}
                    <img src="{{ product.featured_image | img_url: '800x' }}"
                         srcset="{{ product.featured_image | img_url: '400x' }} 400w, {{ product.featured_image | img_url: '800x' }} 800w"
                         sizes="(max-width:768px) 100vw, 33vw"
                         alt="{{ product.featured_image.alt | escape }}"
                         width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
                         class="w-full h-full object-cover" loading="lazy">
                  {%- endif -%}
                </div>
                <h3 class="product-name mb-2 group-hover:opacity-50 transition-opacity">{{ product.title }}</h3>
                <p class="collection-label">Desde {{ product.price_min | money }}</p>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="col-span-3 text-center py-12">
          <p class="section-label">Selecciona una colección en el editor del tema</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Collection grid",
  "settings":[
    {"type":"text",      "id":"eyebrow",       "label":"Eyebrow",                      "default":"Colecciones"},
    {"type":"text",      "id":"heading",       "label":"Heading",                      "default":"Nuestra Línea"},
    {"type":"collection","id":"collection",    "label":"Collection"},
    {"type":"checkbox",  "id":"show_variants", "label":"Mostrar variantes como cards separados", "default":true}
  ],
  "presets":[{"name":"Collection grid"}]
}
{% endschema %}
