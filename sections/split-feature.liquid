{% comment %} sections/split-feature.liquid {% endcomment %}

<section class="split-feature-section" style="
  background:var(--bg);
  min-height:{{ section.settings.section_height }}vh;
  padding-top:{{ section.settings.padding_top }}px;
  padding-bottom:{{ section.settings.padding_bottom }}px;
">
  <div class="split-feature-wrapper">
    
    <div class="split-feature-content split-feature-content--{{ section.settings.content_position }} reveal">
      <span class="section-label split-feature-eyebrow block mb-5">
        {{ section.settings.eyebrow | default: 'Nueva Colección 2026' }}
      </span>

      <h2 class="section-title split-feature-heading mb-7">
        {{ section.settings.heading | default: 'Innovación\nen cada detalle' | newline_to_br }}
      </h2>

      <p class="split-feature-body mb-9">
        {{ section.settings.body | default: 'Cada pieza KAYNOTOMIA fusiona diseño arquitectónico con materiales de vanguardia.' }}
      </p>

      <a href="{{ section.settings.cta_url | default: '#collections' }}" class="link-underline split-feature-cta">
        {{ section.settings.cta_label | default: 'Explorar Colección' }} &nbsp;→
      </a>
    </div>

    <div class="split-feature-image reveal image-hover-zoom" style="animation-delay:.2s;">
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | img_url: '1400x' }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  .split-feature-section {
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .split-feature-wrapper {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  .split-feature-content {
    position: relative;
    padding-left: 6vw;
    padding-right: 4vw;
    max-width: 620px;

    {% if section.settings.content_shift_direction == 'left' %}
      left: -{{ section.settings.content_shift_amount }}px;
    {% else %}
      left: {{ section.settings.content_shift_amount }}px;
    {% endif %}
  }

  .split-feature-content--left {
    justify-self: start;
    text-align: left;
  }

  .split-feature-content--center {
    justify-self: center;
    text-align: center;
  }

  .split-feature-content--right {
    justify-self: end;
    text-align: left;
  }

  .split-feature-content--center .split-feature-body {
    margin-left: auto;
    margin-right: auto;
  }

  .split-feature-eyebrow {
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 400;
    letter-spacing: .35em;
    text-transform: uppercase;
    color: var(--text-light);
  }

  .split-feature-heading {
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: 300;
    line-height: 1.18;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--text);
  }

  .split-feature-body {
    font-size: {{ section.settings.body_size }}px;
    font-weight: 300;
    color: var(--text-light);
    letter-spacing: .03em;
    line-height: 2;
    max-width: 420px;
  }

  .split-feature-cta {
    font-size: {{ section.settings.cta_size }}px;
    font-weight: 500;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--text);
  }

  .split-feature-image {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .split-feature-image img {
    width: {{ section.settings.image_width_desktop }}%;
    max-width: none;
    height: auto;
    max-height: {{ section.settings.image_height }}px;
    object-fit: contain;
    object-position: right center;
    transform: translateX({{ section.settings.image_offset_desktop }}px);
  }

  @media screen and (max-width: 989px) {
    .split-feature-section {
      padding-left: 0;
      padding-right: 0;
    }

    .split-feature-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .split-feature-content {
      left: 0;
      padding-left: 24px;
      padding-right: 24px;
      max-width: none;
    }

    .split-feature-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      letter-spacing: .12em;
    }

    .split-feature-image {
      justify-content: center;
    }

    .split-feature-image img {
      width: {{ section.settings.image_width_mobile }}%;
      max-height: none;
      transform: translateX(0);
      object-position: center center;
    }
  }
</style>

{% schema %}
{
  "name": "Split feature",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Nueva Colección 2026"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Innovación\nen cada detalle"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Cada pieza KAYNOTOMIA fusiona diseño arquitectónico con materiales de vanguardia."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explorar Colección"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "header",
      "content": "Posición del contenido"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Posición base del bloque de texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "content_shift_direction",
      "label": "Mover bloque de texto hacia",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_shift_amount",
      "label": "Cantidad de movimiento del bloque de texto",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Tamaños de texto"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Tamaño texto superior",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Tamaño título en escritorio",
      "min": 24,
      "max": 90,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño título en móvil",
      "min": 22,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Tamaño texto del cuerpo",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "cta_size",
      "label": "Tamaño botón/link",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "Espaciado de sección"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Altura de la sección",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 160,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 160,
      "step": 10,
      "unit": "px",
      "default": 60
    },

    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Altura máxima de imagen",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Tamaño de imagen en escritorio",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 110
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Tamaño de imagen en móvil",
      "min": 60,
      "max": 140,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_offset_desktop",
      "label": "Mover imagen hacia la derecha",
      "min": 0,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Split feature"
    }
  ]
}
{% endschema %}