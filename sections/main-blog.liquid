{% comment %}
  sections/main-blog.liquid
  NUEVO.

  El tema no tenía plantilla de blog ni de artículo. Sin ellas, crear un blog
  en Contenido → Blogs produce URLs que devuelven 404, así que el plan
  editorial no puede ejecutarse.
{% endcomment %}

<style>
  .blog-hero { padding-top:72px; border-bottom:1px solid var(--border); }
  .blog-hero-inner { max-width:1440px; margin:0 auto; padding:80px 24px 64px; }
  @media(min-width:1024px){ .blog-hero-inner { padding:100px 56px 80px; } }
  .blog-label { display:block; font-size:10px; font-weight:500; letter-spacing:.34em; text-transform:uppercase; color:var(--text-muted); margin-bottom:24px; }
  .blog-title { font-family:'Syncopate',sans-serif; font-size:clamp(1.75rem,5vw,4rem); font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--text); line-height:1.05; margin:0; }

  .blog-grid { max-width:1440px; margin:0 auto; padding:64px 24px 96px; display:grid; grid-template-columns:1fr; gap:64px 40px; }
  @media(min-width:768px){ .blog-grid { grid-template-columns:repeat(2,1fr); padding:72px 40px 112px; } }
  @media(min-width:1200px){ .blog-grid { grid-template-columns:repeat(3,1fr); padding:80px 56px 128px; } }

  .blog-card { text-decoration:none; display:block; }
  .blog-card-media { overflow:hidden; background:var(--bg-subtle); aspect-ratio:16/10; margin-bottom:24px; }
  .blog-card-media img { width:100%; height:100%; object-fit:cover; transition:transform .8s cubic-bezier(.4,0,.2,1); }
  .blog-card:hover .blog-card-media img { transform:scale(1.04); }
  .blog-card-date { font-size:10px; font-weight:500; letter-spacing:.28em; text-transform:uppercase; color:var(--text-muted); display:block; margin-bottom:14px; }
  .blog-card-title { font-family:'Syncopate',sans-serif; font-size:14px; font-weight:400; letter-spacing:.12em; text-transform:uppercase; color:var(--text); line-height:1.5; margin:0 0 14px; }
  .blog-card-excerpt { font-size:14px; font-weight:300; color:var(--text-light); line-height:1.9; letter-spacing:.02em; margin:0 0 18px; }
  .blog-card-more { font-size:10px; font-weight:500; letter-spacing:.26em; text-transform:uppercase; color:var(--text); border-bottom:1px solid var(--text); padding-bottom:3px; }

  .blog-empty { max-width:1440px; margin:0 auto; padding:120px 24px; text-align:center; font-size:15px; font-weight:300; color:var(--text-light); }

  .blog-pagination { max-width:1440px; margin:0 auto; padding:0 24px 96px; display:flex; gap:28px; justify-content:center; }
  .blog-pagination a, .blog-pagination span { font-size:11px; font-weight:500; letter-spacing:.24em; text-transform:uppercase; text-decoration:none; color:var(--text-muted); }
  .blog-pagination a:hover { color:var(--text); }
  .blog-pagination .current { color:var(--text); }
</style>

<div class="blog-hero">
  <div class="blog-hero-inner">
    <span class="blog-label">{{ 'general.breadcrumb.journal' | t }}</span>
    <h1 class="blog-title">{{ blog.title | escape }}</h1>
  </div>
</div>

{%- paginate blog.articles by section.settings.articles_per_page -%}
  {%- if blog.articles.size > 0 -%}
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="blog-card">
          {%- if article.image -%}
            <div class="blog-card-media">
              <img
                src="{{ article.image | image_url: width: 800 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w,
                        {{ article.image | image_url: width: 800 }} 800w,
                        {{ article.image | image_url: width: 1200 }} 1200w"
                sizes="(min-width:1200px) 33vw, (min-width:768px) 50vw, 100vw"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="{% if forloop.index <= 2 %}eager{% else %}lazy{% endif %}">
            </div>
          {%- endif -%}

          <time class="blog-card-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {{ article.published_at | date: '%d.%m.%Y' }}
          </time>

          <h2 class="blog-card-title">{{ article.title | escape }}</h2>

          {%- if section.settings.show_excerpt -%}
            <p class="blog-card-excerpt">
              {{ article.excerpt_or_content | strip_html | truncatewords: 28 }}
            </p>
          {%- endif -%}

          <span class="blog-card-more">{{ 'blogs.general.read_more' | t }}</span>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="blog-pagination" role="navigation">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            <span class="current">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  {%- else -%}
    <p class="blog-empty">{{ 'blogs.general.no_articles' | t }}</p>
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Artículos por página",
      "min": 6, "max": 24, "step": 3, "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Mostrar extracto",
      "default": true
    }
  ]
}
{% endschema %}
