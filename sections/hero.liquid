{% comment %} sections/hero.liquid {% endcomment %}

<section
  id="heroSection"
  class="relative h-screen flex items-center justify-center overflow-hidden"
  style="
    background:var(--bg-subtle);
    --hero-overlay: {{ section.settings.overlay_opacity | times: 0.01 }};
    --hero-overlay-mobile: {{ section.settings.mobile_overlay_opacity | times: 0.01 }};
    --hero-mobile-height: {{ section.settings.mobile_height }}vh;
    --hero-mobile-content-y: {{ section.settings.mobile_content_y }}px;
    --hero-mobile-subheading-mt: {{ section.settings.mobile_subheading_margin_top }}px;
    --hero-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --hero-mobile-subheading-size: {{ section.settings.mobile_subheading_size }}px;
    --hero-mobile-eyebrow-size: {{ section.settings.mobile_eyebrow_size }}px;
    --hero-mobile-text-width: {{ section.settings.mobile_text_width }}px;
  "
>

  <div id="heroSlider">
    {% for block in section.blocks %}
      {% if block.type == 'slide' %}

        {% assign desktop_mode = block.settings.media_type %}
        {% assign mobile_mode = block.settings.mobile_media_type %}

        {% assign has_mobile_override = false %}
        {% if mobile_mode != 'same' %}
          {% assign has_mobile_override = true %}
        {% endif %}

        <div
          class="hero-slide {% if forloop.first %}active{% endif %} {% if has_mobile_override %}has-mobile-override{% endif %} {% if mobile_mode == 'none' %}mobile-media-none{% endif %}"
          style="
            --media-position-desktop: {{ block.settings.desktop_position }};
            --media-position-mobile: {{ block.settings.mobile_position }};
          "
          {{ block.shopify_attributes }}
        >

          <div class="hero-media-wrap hero-desktop-media">

            {% if desktop_mode == 'image_video' %}

              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 2000 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  class="hero-media hero-media-image"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              {% endif %}

              {% if block.settings.video != blank %}
                {{ block.settings.video | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'auto',
                  image_size: '2000x',
                  class: 'hero-media hero-media-video'
                }}
              {% endif %}

            {% elsif desktop_mode == 'video' %}

              {% if block.settings.video != blank %}
                {{ block.settings.video | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'auto',
                  image_size: '2000x',
                  class: 'hero-media hero-media-video'
                }}
              {% endif %}

            {% elsif desktop_mode == 'image' %}

              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 2000 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  class="hero-media hero-media-image"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              {% endif %}

            {% endif %}

          </div>

          {% if has_mobile_override %}
            <div class="hero-media-wrap hero-mobile-media">

              {% if mobile_mode == 'image_video' %}

                {% if block.settings.mobile_image != blank %}
                  <img
                    src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
                    alt="{{ block.settings.mobile_image.alt | escape }}"
                    class="hero-media hero-media-image"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  >
                {% endif %}

                {% if block.settings.mobile_video != blank %}
                  {{ block.settings.mobile_video | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    playsinline: true,
                    preload: 'auto',
                    image_size: '1000x',
                    class: 'hero-media hero-media-video'
                  }}
                {% endif %}

              {% elsif mobile_mode == 'video' %}

                {% if block.settings.mobile_video != blank %}
                  {{ block.settings.mobile_video | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    playsinline: true,
                    preload: 'auto',
                    image_size: '1000x',
                    class: 'hero-media hero-media-video'
                  }}
                {% endif %}

              {% elsif mobile_mode == 'image' %}

                {% if block.settings.mobile_image != blank %}
                  <img
                    src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
                    alt="{{ block.settings.mobile_image.alt | escape }}"
                    class="hero-media hero-media-image"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  >
                {% endif %}

              {% endif %}

            </div>
          {% endif %}

        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="hero-overlay"></div>

  <button class="hero-arrow hero-arrow-prev" id="heroPrev" aria-label="Slide anterior">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>

  <button class="hero-arrow hero-arrow-next" id="heroNext" aria-label="Siguiente slide">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 6 15 12 9 18"/>
    </svg>
  </button>

  <div class="hero-dots" id="heroDots"></div>

  <div class="hero-progress">
    <div class="hero-progress-fill" id="heroProgressFill"></div>
  </div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto hero-content">

    {% if section.settings.eyebrow != blank %}
      <p class="hero-eyebrow mb-6 animate-fade-up" style="font-size:12px;letter-spacing:.38em;font-weight:500;text-transform:uppercase;animation-delay:.3s;">
        <span style="color:{{ section.settings.eyebrow_color }};">
          {{ section.settings.eyebrow }}
        </span>
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="hero-heading section-title text-4xl md:text-6xl lg:text-7xl text-white mb-8 animate-fade-up" style="font-weight:200;animation-delay:.5s;letter-spacing:.2em;">
        {{ section.settings.heading | newline_to_br }}
      </h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="hero-subheading text-white/80 mb-10 max-w-lg mx-auto animate-fade-up" style="font-size:15px;font-weight:300;letter-spacing:.07em;line-height:2;animation-delay:.7s;margin-top:10px;">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#configurator' }}" class="btn-luxury animate-fade-up hero-cta" style="animation-delay:.9s;">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}

  </div>

</section>

<style>
  #heroSection {
    position: relative;
  }

  #heroSlider,
  .hero-slide,
  .hero-media-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #heroSlider {
    z-index: 1;
  }

  .hero-slide {
    opacity: 0;
    visibility: hidden;
    transition: opacity 900ms ease, visibility 900ms ease;
    background: #000;
  }

  .hero-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .hero-media-wrap {
    overflow: hidden;
    background: #000;
  }

  .hero-mobile-media {
    display: none;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--media-position-desktop);
    display: block;
  }

  .hero-media-image {
    z-index: 1;
  }

  .hero-media-video {
    z-index: 2;
  }

  .hero-video-error {
    opacity: 0;
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, var(--hero-overlay));
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 10;
  }

  .hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 12;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 50%;
    color: white;
    background: rgba(255,255,255,.08);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .hero-arrow-prev {
    left: 24px;
  }

  .hero-arrow-next {
    right: 24px;
  }

  .hero-dots {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 12;
    display: flex;
    gap: 10px;
  }

  .hero-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid white;
    background: transparent;
    cursor: pointer;
    opacity: .7;
  }

  .hero-dot.active {
    background: white;
    opacity: 1;
  }

  .hero-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    z-index: 12;
    background: rgba(255,255,255,.18);
  }

  .hero-progress-fill {
    height: 100%;
    width: 0%;
    background: white;
  }

  .hero-slider-disabled .hero-arrow,
  .hero-slider-disabled .hero-dots,
  .hero-slider-disabled .hero-progress {
    display: none !important;
  }

  @media screen and (max-width: 768px) {
    #heroSection {
      height: var(--hero-mobile-height);
      min-height: var(--hero-mobile-height);
    }

    .hero-slide.has-mobile-override .hero-desktop-media {
      display: none;
    }

    .hero-slide.has-mobile-override .hero-mobile-media {
      display: block;
    }

    .hero-slide.mobile-media-none .hero-mobile-media {
      display: none;
    }

    .hero-media {
      object-position: var(--media-position-mobile);
    }

    .hero-overlay {
      background: rgba(0, 0, 0, var(--hero-overlay-mobile));
    }

    .hero-content {
      transform: translateY(var(--hero-mobile-content-y));
      max-width: var(--hero-mobile-text-width);
    }

    .hero-eyebrow {
      font-size: var(--hero-mobile-eyebrow-size) !important;
      margin-bottom: 18px !important;
    }

    .hero-heading {
      font-size: var(--hero-mobile-heading-size) !important;
      line-height: 1.15 !important;
      letter-spacing: .14em !important;
    }

    .hero-subheading {
      font-size: var(--hero-mobile-subheading-size) !important;
      margin-top: var(--hero-mobile-subheading-mt) !important;
      line-height: 1.8 !important;
      max-width: var(--hero-mobile-text-width) !important;
    }

    .hero-cta {
      padding-left: 32px !important;
      padding-right: 32px !important;
    }

    .hero-arrow {
      width: 38px;
      height: 38px;
    }

    .hero-arrow-prev {
      left: 12px;
    }

    .hero-arrow-next {
      right: 12px;
    }

    .hero-dots {
      bottom: 24px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hero = document.getElementById('heroSection');
    if (!hero || hero.dataset.initialized === 'true') return;

    hero.dataset.initialized = 'true';

    const slides = hero.querySelectorAll('#heroSlider .hero-slide');
    const prev = hero.querySelector('#heroPrev');
    const next = hero.querySelector('#heroNext');
    const dotsContainer = hero.querySelector('#heroDots');
    const progressFill = hero.querySelector('#heroProgressFill');

    if (!slides.length) return;

    let current = 0;
    let interval;
    let progressInterval;
    const duration = {{ section.settings.slide_duration | times: 1000 }};

    if (slides.length <= 1) {
      hero.classList.add('hero-slider-disabled');
    }

    function isVisibleVideo(video) {
      const wrapper = video.closest('.hero-media-wrap');
      if (!wrapper) return true;

      const styles = window.getComputedStyle(wrapper);
      return styles.display !== 'none' && styles.visibility !== 'hidden' && styles.opacity !== '0';
    }

    function isActiveVisibleVideo(video) {
      const slide = video.closest('.hero-slide');
      return slide && slide.classList.contains('active') && isVisibleVideo(video);
    }

    function safePlay(video) {
      const playPromise = video.play();

      if (playPromise !== undefined) {
        playPromise.catch(function () {
          /*
            Algunos móviles bloquean autoplay en modo ahorro de batería.
            El siguiente touchstart vuelve a intentar reproducirlo.
          */
        });
      }
    }

    function restartVideoLoop(video) {
      if (!isActiveVisibleVideo(video)) return;

      try {
        video.pause();
        video.currentTime = 0;
      } catch (error) {}

      safePlay(video);
    }

    function bindForcedLoop(video) {
      if (video.dataset.heroLoopReady === 'true') return;
      video.dataset.heroLoopReady = 'true';

      video.addEventListener('ended', function () {
        restartVideoLoop(video);
      });

      video.addEventListener('pause', function () {
        if (video.ended) {
          restartVideoLoop(video);
        }
      });

      video.addEventListener('timeupdate', function () {
        if (!isActiveVisibleVideo(video)) return;
        if (!video.duration || Number.isNaN(video.duration)) return;

        /*
          Refuerzo extra para Safari/iPhone:
          si el video llega casi al final y no dispara bien el loop,
          lo mandamos manualmente al inicio.
        */
        if (video.currentTime >= video.duration - 0.12) {
          restartVideoLoop(video);
        }
      });

      video.addEventListener('error', function () {
        video.classList.add('hero-video-error');
      });
    }

    function prepareVideoForAutoplay(video) {
      video.muted = true;
      video.defaultMuted = true;
      video.autoplay = true;
      video.loop = true;
      video.playsInline = true;
      video.controls = false;
      video.preload = 'auto';

      video.setAttribute('muted', '');
      video.setAttribute('autoplay', '');
      video.setAttribute('loop', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('preload', 'auto');
      video.removeAttribute('controls');

      bindForcedLoop(video);
    }

    function playCurrentVideo() {
      slides.forEach(function (slide, index) {
        const videos = slide.querySelectorAll('video');

        videos.forEach(function (video) {
          prepareVideoForAutoplay(video);

          if (index === current && isVisibleVideo(video)) {
            if (video.ended) {
              video.currentTime = 0;
            }

            safePlay(video);
          } else {
            video.pause();

            try {
              video.currentTime = 0;
            } catch (error) {}
          }
        });
      });
    }

    function showSlide(index) {
      slides[current].classList.remove('active');

      if (dotsContainer && dotsContainer.children[current]) {
        dotsContainer.children[current].classList.remove('active');
      }

      current = (index + slides.length) % slides.length;

      slides[current].classList.add('active');

      if (dotsContainer && dotsContainer.children[current]) {
        dotsContainer.children[current].classList.add('active');
      }

      playCurrentVideo();
      restartProgress();
    }

    function nextSlide() {
      showSlide(current + 1);
    }

    function prevSlide() {
      showSlide(current - 1);
    }

    function restartAutoplay() {
      clearInterval(interval);

      if (slides.length <= 1) return;

      interval = setInterval(nextSlide, duration);
    }

    function restartProgress() {
      clearInterval(progressInterval);

      if (!progressFill || slides.length <= 1) return;

      let width = 0;
      progressFill.style.width = '0%';

      progressInterval = setInterval(function () {
        width += 100 / (duration / 100);
        progressFill.style.width = width + '%';

        if (width >= 100) {
          clearInterval(progressInterval);
        }
      }, 100);
    }

    if (dotsContainer && slides.length > 1) {
      slides.forEach(function (slide, index) {
        const dot = document.createElement('button');
        dot.className = 'hero-dot';
        dot.setAttribute('aria-label', 'Ir al slide ' + (index + 1));

        if (index === 0) {
          dot.classList.add('active');
        }

        dot.addEventListener('click', function () {
          showSlide(index);
          restartAutoplay();
        });

        dotsContainer.appendChild(dot);
      });
    }

    if (next && slides.length > 1) {
      next.addEventListener('click', function () {
        nextSlide();
        restartAutoplay();
      });
    }

    if (prev && slides.length > 1) {
      prev.addEventListener('click', function () {
        prevSlide();
        restartAutoplay();
      });
    }

    window.addEventListener('resize', playCurrentVideo);
    window.addEventListener('pageshow', playCurrentVideo);

    document.addEventListener('touchstart', function () {
      playCurrentVideo();
    }, { once: true });

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) {
        playCurrentVideo();
      }
    });

    playCurrentVideo();
    restartProgress();
    restartAutoplay();
  });
</script>

