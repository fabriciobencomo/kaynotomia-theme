{% comment %} sections/main-page-about.liquid {% endcomment %}

<style>
/* ── ABOUT HERO ───────────────────────────── */
#aboutHero{
  position:relative;
  height:100vh;
  overflow:hidden;
  display:flex;
  align-items:flex-end;
  padding-top:0;
  background:var(--bg-mid);
}

#aboutHeroMedia{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  overflow:hidden;
  background:var(--bg-mid);
}

#aboutHeroMedia .about-hero-media{
  position:absolute;
  inset:0;
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 20%;
  transform:scale(1.08);
  animation:aboutZoom 2.4s cubic-bezier(.16,1,.3,1) forwards;
}

#aboutHeroMedia .about-hero-image{
  z-index:1;
}

#aboutHeroMedia .about-hero-video-layer{
  position:absolute;
  inset:0;
  z-index:2;
  width:100%;
  height:100%;
  overflow:hidden;
  pointer-events:none;
}

#aboutHeroMedia .about-hero-video{
  z-index:2;
  pointer-events:none;
}

#aboutHeroMedia .about-hero-video--desktop,
#aboutHeroMedia .about-hero-video--universal{
  display:block;
}

#aboutHeroMedia .about-hero-video--mobile{
  display:none;
}

#aboutHeroMedia .about-hero-video--desktop,
#aboutHeroMedia .about-hero-video--universal{
  object-position:{{ section.settings.hero_video_position_desktop | default: 'center center' }};
}

#aboutHeroMedia .about-hero-video--mobile{
  object-position:{{ section.settings.hero_video_position_mobile | default: 'center center' }};
}

#aboutHeroMedia .about-hero-placeholder{
  position:absolute;
  inset:0;
  z-index:0;
  background:var(--bg-mid);
}

@keyframes aboutZoom{
  to{
    transform:scale(1);
  }
}

#aboutHeroOverlay{
  position:absolute;
  inset:0;
  z-index:3;
  pointer-events:none;
  background:linear-gradient(
    to top,
    rgba(0,0,0,1) 0%,
    rgba(0,0,0,.82) 50%,
    transparent 100%
  );
}

#aboutHeroContent{
  position:relative;
  z-index:4;
  width:100%;
  padding:0 7vw 8vh;
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:40px;
  flex-wrap:wrap;
}

.about-fade-up{
  opacity:0;
  animation:aboutFadeUp .9s cubic-bezier(.16,1,.3,1) forwards;
}

@keyframes aboutFadeUp{
  from{
    opacity:0;
    transform:translateY(32px);
  }

  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* ── STATEMENT LINES ──────────────────────── */
.statement-line{
  overflow:hidden;
  margin-bottom:8px;
}

.statement-line span{
  display:block;
  transform:translateY(100%);
  transition:transform .9s cubic-bezier(.16,1,.3,1);
}

.statement-line.revealed span{
  transform:translateY(0);
}

/* ── STATEMENT CONTROLS ───────────────────── */
#aboutStatement .about-statement-position{
  display:flex;
  width:100%;
}

#aboutStatement .about-statement-position--left{
  justify-content:flex-start;
}

#aboutStatement .about-statement-position--center{
  justify-content:center;
}

#aboutStatement .about-statement-position--right{
  justify-content:flex-end;
}

#aboutStatement .about-statement-inner{
  width:100%;
  max-width:var(--statement-max-width);
}

#aboutStatement .about-statement-text-align--left{
  text-align:left;
}

#aboutStatement .about-statement-text-align--center{
  text-align:center;
}

#aboutStatement .about-statement-text-align--right{
  text-align:right;
}

#aboutStatement .about-statement-text{
  font-size:var(--statement-font-desktop);
  line-height:var(--statement-line-height);
}

/* ── MARQUEE ──────────────────────────────── */
.about-marquee-wrap{
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  padding:20px 0;
  overflow:hidden;
  background:var(--bg-subtle);
}

.marquee-track{
  display:flex;
  gap:0;
  width:max-content;
  animation:aboutMarquee 22s linear infinite;
}

.marquee-track:hover{
  animation-play-state:paused;
}

@keyframes aboutMarquee{
  from{
    transform:translateX(0);
  }

  to{
    transform:translateX(-50%);
  }
}

/* ── QUOTE SECTION ────────────────────────── */
#aboutQuoteSection{
  position:relative;
  overflow:hidden;
  min-height:70vh;
  display:flex;
  align-items:center;
}

#aboutQuoteBg{
  position:absolute;
  inset:0;
  /* FIX PERF-02 — Era strangeattractor.gif (4,7 MB). WebP animado equivalente: 1,0 MB (-79%).
     El .gif original NO está versionado (4,7 MB de binario en el historial de Git para siempre);
     se conserva en el export original del tema. strangeattractor.mp4 (0,61 MB)
     está disponible si se migra a <video> — ver CHANGELOG. */
  background-image:url('{{ "strangeattractor.webp" | asset_url }}');
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
}

#aboutQuoteBg::after{
  content:'';
  position:absolute;
  inset:0;
  background:rgba(9,9,9,.9);
}

/* ── VALUES GRID ──────────────────────────── */
.about-values-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2px;
}

.about-value-card{
  background:var(--bg);
  padding:30px 30px 44px;
  overflow:hidden;
}

.about-value-image-wrap{
  width:min(100%, {{ section.settings.values_image_width | default: 240 }}px);
  aspect-ratio:4/5;
  overflow:hidden;
  background:var(--bg-mid);
  margin:0 0 30px;
}

.about-value-image-wrap img{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  transition:transform .8s cubic-bezier(.4,0,.2,1);
}

.about-value-card:hover .about-value-image-wrap img{
  transform:scale(1.04);
}

.about-values-images--center .about-value-image-wrap{
  margin-left:auto;
  margin-right:auto;
}

.about-values-images--right .about-value-image-wrap{
  margin-left:auto;
  margin-right:0;
}

/* ── ABOUT SPLIT ──────────────────────────── */
.about-split-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:80px;
  align-items:center;
  max-width:1300px;
  margin:0 auto;
}

.about-split-text{
  width:100%;
}

.about-split-text--left{
  justify-self:start;
  text-align:left;
}

.about-split-text--center{
  justify-self:center;
  text-align:center;
}

.about-split-text--right{
  justify-self:end;
  text-align:right;
}

.about-split-text--center .about-split-paragraph{
  margin-left:auto !important;
  margin-right:auto !important;
}

.about-split-text--right .about-split-paragraph{
  margin-left:auto !important;
  margin-right:0 !important;
}

.about-split-text--center .about-split-link{
  display:inline-block;
  margin-left:auto;
  margin-right:auto;
}

.about-split-text--right .about-split-link{
  display:inline-block;
  margin-left:auto;
}

.about-split-grid--text-right .about-split-text{
  order:2;
}

.about-split-grid--text-right .about-split-media{
  order:1;
}

/* ── IMG HOVER ────────────────────────────── */
.about-img-hover{
  overflow:hidden;
}

.about-img-hover img{
  transition:transform .9s cubic-bezier(.4,0,.2,1);
}

.about-img-hover:hover img{
  transform:scale(1.04);
}

/* ── MOBILE ───────────────────────────────── */
@media(max-width:767px){
  #aboutHero{
    min-height:100svh;
    height:100svh;
  }

  #aboutHeroContent{
    padding:0 24px 48px;
    gap:28px;
  }

  #aboutHeroContent > div:last-child{
    max-width:100% !important;
  }

  #aboutHeroMedia .about-hero-media{
    object-position:center center;
  }

  #aboutHeroMedia .about-hero-video--desktop{
    display:none !important;
  }

  #aboutHeroMedia .about-hero-video--mobile{
    display:block !important;
  }

  #aboutHeroMedia .about-hero-video--mobile,
  #aboutHeroMedia .about-hero-video--universal{
    object-position:{{ section.settings.hero_video_position_mobile | default: 'center center' }};
  }

  .about-values-grid{
    grid-template-columns:1fr;
  }

  .about-value-card{
    padding:24px 24px 38px;
  }

  .about-value-image-wrap{
    width:min(100%, {{ section.settings.values_image_width_mobile | default: 220 }}px);
    margin-bottom:26px;
  }

  .about-split-grid{
    grid-template-columns:1fr;
    gap:48px;
  }

  .about-split-grid--text-right .about-split-text{
    order:1;
  }

  .about-split-grid--text-right .about-split-media{
    order:2;
  }

  #aboutStatement .about-statement-text{
    font-size:var(--statement-font-mobile);
  }
}
</style>

<!-- ═══ HERO ══════════════════════════════ -->

{%- assign hero_media_mode = section.settings.hero_media_mode | default: 'image' -%}
{%- assign show_hero_image = false -%}
{%- assign show_hero_video = false -%}

{%- assign hero_video_desktop = section.settings.hero_video -%}
{%- assign hero_video_mobile = section.settings.hero_video_mobile -%}

{%- if hero_video_desktop == blank and hero_video_mobile != blank -%}
  {%- assign hero_video_desktop = hero_video_mobile -%}
{%- endif -%}

{%- if hero_video_mobile == blank and hero_video_desktop != blank -%}
  {%- assign hero_video_mobile = hero_video_desktop -%}
{%- endif -%}

{%- assign has_any_hero_video = false -%}

{%- if hero_video_desktop != blank or hero_video_mobile != blank -%}
  {%- assign has_any_hero_video = true -%}
{%- endif -%}

{%- case hero_media_mode -%}
  {%- when 'video' -%}
    {%- assign show_hero_video = true -%}

  {%- when 'both' -%}
    {%- assign show_hero_image = true -%}
    {%- assign show_hero_video = true -%}

  {%- else -%}
    {%- assign show_hero_image = true -%}
{%- endcase -%}

{%- if show_hero_video and has_any_hero_video == false -%}
  {%- assign show_hero_video = false -%}

  {%- if section.settings.hero_image != blank -%}
    {%- assign show_hero_image = true -%}
  {%- endif -%}
{%- endif -%}

{%- if show_hero_image and section.settings.hero_image == blank -%}
  {%- assign show_hero_image = false -%}

  {%- if has_any_hero_video -%}
    {%- assign show_hero_video = true -%}
  {%- endif -%}
{%- endif -%}

{%- assign hero_video_opacity = 1 -%}

{%- if hero_media_mode == 'both'
  and show_hero_image
  and show_hero_video
-%}
  {%- assign hero_video_opacity = section.settings.hero_video_opacity | divided_by: 100.0 -%}
{%- endif -%}

<section id="aboutHero" style="padding-top:0;">

  <div
    id="aboutHeroMedia"
    class="about-hero-media-mode--{{ hero_media_mode }}"
  >

    {%- if show_hero_image -%}
      <img
        class="about-hero-media about-hero-image"
        src="{{ section.settings.hero_image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.hero_image | image_url: width: 750 }} 750w,
          {{ section.settings.hero_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.hero_image | image_url: width: 1600 }} 1600w,
          {{ section.settings.hero_image | image_url: width: 2000 }} 2000w,
          {{ section.settings.hero_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        width="{{ section.settings.hero_image.width }}"
        height="{{ section.settings.hero_image.height }}"
        alt="{{ section.settings.hero_image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}

    {%- if show_hero_video -%}
      <div
        class="about-hero-video-layer"
        style="opacity:{{ hero_video_opacity }};"
      >

        {%- if section.settings.hero_video != blank
          and section.settings.hero_video_mobile != blank
        -%}

          {{
            hero_video_desktop
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata',
              class: 'about-hero-media about-hero-video about-hero-video--desktop'
          }}

          {{
            hero_video_mobile
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata',
              class: 'about-hero-media about-hero-video about-hero-video--mobile'
          }}

        {%- else -%}

          {{
            hero_video_desktop
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata',
              class: 'about-hero-media about-hero-video about-hero-video--universal'
          }}

        {%- endif -%}

      </div>
    {%- endif -%}

    {%- unless show_hero_image or show_hero_video -%}
      <div class="about-hero-placeholder"></div>
    {%- endunless -%}

  </div>

  <div id="aboutHeroOverlay"></div>

  <div id="aboutHeroContent">
    <div>

      <p
        class="about-fade-up"
        style="
          font-size:11px;
          letter-spacing:.38em;
          text-transform:uppercase;
          color:rgba(255,255,255,.6);
          margin:0 0 10px;
          animation-delay:.4s;
        "
      >
        {{ section.settings.hero_role | default: 'Diseñadora Industrial' }}
      </p>

      <h1
        class="about-fade-up"
        style="
          font-family:'Syncopate',sans-serif;
          font-size:clamp(2rem,5vw,4.5rem);
          font-weight:700;
          color:#fff;
          margin:0;
          line-height:.95;
          letter-spacing:.04em;
          animation-delay:.55s;
        "
      >
        {{ section.settings.hero_name | default: 'YOHANA' }}
      </h1>

      <p
        class="about-fade-up"
        style="
          font-family:'Syncopate',sans-serif;
          font-size:clamp(1.1rem,2.6vw,2.4rem);
          font-weight:400;
          color:rgba(255,255,255,.5);
          margin:4px 0 0;
          letter-spacing:.12em;
          text-transform:uppercase;
          animation-delay:.65s;
        "
      >
        {{ shop.name | upcase }}
      </p>

    </div>

    <div
      class="about-fade-up"
      style="max-width:360px;animation-delay:.8s;"
    >
      <p
        style="
          font-size:14px;
          font-weight:300;
          line-height:2;
          letter-spacing:.05em;
          color:rgba(255,255,255,.75);
          margin:0;
        "
      >
        {{
          section.settings.hero_bio
          | default: 'I am an industrial designer constantly seeking projects that explore the intersection between the body, human needs, nature, and technology.'
        }}
      </p>
    </div>
  </div>
</section>

<!-- ═══ STATEMENT ═════════════════════════ -->

<section
  id="aboutStatement"
  style="
    background:var(--bg);
    padding:
      {{ section.settings.statement_padding_top | default: 120 }}px
      7vw
      {{ section.settings.statement_padding_bottom | default: 120 }}px;
  "
>
  <div
    class="
      about-statement-position
      about-statement-position--{{ section.settings.statement_position | default: 'left' }}
    "
  >
    <div
      class="
        about-statement-inner
        about-statement-text-align--{{ section.settings.statement_text_alignment | default: 'left' }}
      "
      style="
        --statement-max-width:{{ section.settings.statement_max_width | default: 1100 }}px;
        --statement-font-desktop:{{ section.settings.statement_font_size | default: 64 }}px;
        --statement-font-mobile:{{ section.settings.statement_font_size_mobile | default: 32 }}px;
        --statement-line-height:{{ section.settings.statement_line_height | default: 110 | divided_by: 100.0 }};
      "
    >

      <p
        class="section-label reveal"
        style="margin-bottom:{{ section.settings.statement_label_spacing | default: 48 }}px;"
      >
        {{ section.settings.statement_label | default: 'Design Philosophy' }}
      </p>

      {%- assign statement_lines = section.settings.statement_text
        | default: 'Where the body|meets nature & technology|— design emerges.'
        | split: '|'
      -%}

      {%- for line in statement_lines -%}
        <div
          class="statement-line"
          style="{%- unless forloop.last -%}margin-bottom:{{ section.settings.statement_line_gap | default: 8 }}px;{%- endunless -%}"
        >
          <span
            class="about-statement-text"
            style="
              font-family:'Jost',sans-serif;
              font-weight:200;
              letter-spacing:.06em;
              color:var(--text);
            "
          >
            {{ line }}
          </span>
        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

<!-- ═══ MARQUEE ═══════════════════════════ -->

<div class="about-marquee-wrap">
  <div
    class="marquee-track"
    style="
      font-size:11px;
      font-weight:500;
      letter-spacing:.32em;
      text-transform:uppercase;
      color:var(--text-muted);
      white-space:nowrap;
    "
  >

    {%- assign marquee_items = section.settings.marquee_text
      | default: 'Industrial Design · 3D Printing · Handcrafted · Body & Space · KAYNOTOMIA · Sustainable Materials · Personalization · Design Beyond Convention'
      | split: ' · '
    -%}

    {%- for item in marquee_items -%}
      <span style="padding:0 40px;">
        {{ item }}&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;
      </span>
    {%- endfor -%}

    {%- for item in marquee_items -%}
      <span style="padding:0 40px;">
        {{ item }}&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;
      </span>
    {%- endfor -%}

  </div>
</div>

<!-- ═══ SPLIT — THE DESIGNER ══════════════ -->

<section style="background:var(--bg);padding:120px 7vw;">
  <div class="about-split-grid">

    <div>

      <p class="section-label reveal" style="margin-bottom:32px;">
        {{ section.settings.split_label | default: 'The Designer' }}
      </p>

      <h2
        class="reveal"
        style="
          font-family:'Jost',sans-serif;
          font-size:clamp(1.4rem,2.4vw,2rem);
          font-weight:300;
          letter-spacing:.16em;
          text-transform:uppercase;
          color:var(--text);
          line-height:1.2;
          margin:0 0 36px;
          animation-delay:.1s;
        "
      >
        {{
          section.settings.split_heading
          | default: 'Creativity Without Boundaries'
          | newline_to_br
        }}
      </h2>

      {%- assign split_paragraphs = section.settings.split_body
        | default: 'Yohana is an industrial designer based in Latin America, driven by curiosity and a deep respect for materials, the human form, and the natural world.|KAYNOTOMIA is the expression of that search — a brand where each piece is sculpted through 3D printing, assembled by hand, and made to last.'
        | split: '|'
      -%}

      {%- for para in split_paragraphs -%}
        <p
          class="reveal"
          style="
            font-size:15px;
            font-weight:300;
            color:var(--text-light);
            line-height:2.1;
            letter-spacing:.03em;
            max-width:440px;
            margin:0 0 24px;
            animation-delay:{{ forloop.index | times: 0.1 | plus: 0.1 }}s;
          "
        >
          {{ para }}
        </p>
      {%- endfor -%}

      <a
        href="{{ section.settings.split_cta_url | default: routes.root_url | append: 'products/nimbus' }}"
        class="link-underline reveal"
        style="
          font-size:12px;
          font-weight:500;
          letter-spacing:.26em;
          text-transform:uppercase;
          color:var(--text);
          text-decoration:none;
          animation-delay:.4s;
        "
      >
        {{ section.settings.split_cta_label | default: 'Build Your Piece' }}
        &nbsp;→
      </a>

    </div>

    <div
      class="reveal about-img-hover"
      style="animation-delay:.2s;"
    >
      <div
        style="
          aspect-ratio:3/4;
          overflow:hidden;
          background:var(--bg-mid);
        "
      >

        {%- if section.settings.split_image -%}
          <img
            src="{{ section.settings.split_image | image_url: width: 1200 }}"
            alt="{{ section.settings.split_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.split_image.width }}"
            height="{{ section.settings.split_image.height }}"
            style="
              width:100%;
              height:100%;
              object-fit:cover;
              object-position:40% 30%;
              transition:transform .9s cubic-bezier(.4,0,.2,1);
            "
          >

        {%- elsif section.settings.hero_image -%}
          <img
            src="{{ section.settings.hero_image | image_url: width: 1200 }}"
            alt="{{ section.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.hero_image.width }}"
            height="{{ section.settings.hero_image.height }}"
            style="
              width:100%;
              height:100%;
              object-fit:cover;
              object-position:40% 30%;
              transition:transform .9s cubic-bezier(.4,0,.2,1);
            "
          >
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

<!-- ═══ QUOTE ══════════════════════════════ -->

<section id="aboutQuoteSection">
  <div id="aboutQuoteBg"></div>

  <div
    style="
      position:relative;
      z-index:1;
      width:100%;
      padding:120px 7vw;
    "
  >
    <div style="max-width:900px;margin:0 auto;text-align:center;">

      <p
        class="section-label reveal"
        style="
          color:rgba(255,255,255,.4);
          margin-bottom:48px;
        "
      >
        {{ section.settings.quote_label | default: 'The Vision' }}
      </p>

      <blockquote
        class="reveal"
        style="
          font-family:'Jost',sans-serif;
          font-size:clamp(1.2rem,2.8vw,2.2rem);
          font-weight:200;
          letter-spacing:.1em;
          line-height:1.7;
          color:rgba(255,255,255,.9);
          margin:0 0 48px;
          font-style:normal;
          animation-delay:.15s;
        "
      >
        “{{
          section.settings.quote_text
          | default: 'I am an industrial designer constantly seeking projects that explore the intersection between the body, human needs, nature, and technology.'
        }}”
      </blockquote>

      <p
        class="reveal"
        style="
          font-size:11px;
          font-weight:500;
          letter-spacing:.38em;
          text-transform:uppercase;
          color:rgba(255,255,255,.35);
          margin:0;
          animation-delay:.3s;
        "
      >
        — {{
          section.settings.quote_author
          | default: 'Yohana, Founder of KAYNOTOMIA'
        }}
      </p>

    </div>
  </div>
</section>

<!-- ═══ VALUES GRID ════════════════════════ -->

<section style="background:var(--bg-subtle);padding:120px 7vw;">
  <div style="max-width:1300px;margin:0 auto;">

    <p class="section-label reveal" style="margin-bottom:64px;">
      {{ section.settings.values_label | default: 'What drives the work' }}
    </p>

    <div
      class="about-values-grid about-values-images--{{ section.settings.values_image_alignment | default: 'left' }}"
    >

      {%- for block in section.blocks -%}
        {%- if block.type == 'value' -%}

          <div
            class="reveal about-value-card"
            style="animation-delay:{{ forloop.index0 | times: 0.1 }}s;"
            {{ block.shopify_attributes }}
          >

            {%- if block.settings.image != blank -%}
              <div class="about-value-image-wrap">
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 320 }} 320w,
                    {{ block.settings.image | image_url: width: 520 }} 520w,
                    {{ block.settings.image | image_url: width: 720 }} 720w,
                    {{ block.settings.image | image_url: width: 900 }} 900w
                  "
                  sizes="(max-width:767px) 70vw, {{ section.settings.values_image_width | default: 240 }}px"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                >
              </div>
            {%- endif -%}

            <p
              style="
                font-size:11px;
                font-weight:500;
                letter-spacing:.32em;
                text-transform:uppercase;
                color:var(--text-muted);
                margin:0 0 20px;
              "
            >
              0{{ forloop.index }}
            </p>

            <h3
              style="
                font-size:16px;
                font-weight:500;
                letter-spacing:.18em;
                text-transform:uppercase;
                color:var(--text);
                margin:0 0 16px;
              "
            >
              {{ block.settings.title }}
            </h3>

            <p
              style="
                font-size:14px;
                font-weight:300;
                color:var(--text-light);
                line-height:2;
                letter-spacing:.03em;
                margin:0;
              "
            >
              {{ block.settings.body }}
            </p>

          </div>

        {%- endif -%}
      {%- endfor -%}

    </div>

  </div>
</section>

<!-- ═══ CTA ════════════════════════════════ -->

<section
  style="
    background:var(--bg);
    padding:120px 7vw;
    text-align:center;
  "
>

  <p class="section-label reveal" style="margin-bottom:32px;">
    {{ section.settings.cta_label | default: 'The Collection' }}
  </p>

  <h2
    class="reveal"
    style="
      font-family:'Jost',sans-serif;
      font-size:clamp(2rem,5vw,4rem);
      font-weight:200;
      letter-spacing:.14em;
      text-transform:uppercase;
      color:var(--text);
      margin:0 0 48px;
      line-height:1.1;
      animation-delay:.1s;
    "
  >
    {{ section.settings.cta_heading | default: 'NIMBUS' }}
  </h2>

  <a
    href="{{ section.settings.cta_url | default: routes.root_url | append: 'products/nimbus' }}"
    class="reveal btn-luxury btn-luxury-dark"
    style="animation-delay:.2s;"
  >
    {{ section.settings.cta_btn | default: 'Personaliza el Tuyo' }}
  </a>

</section>

<script>
(function(){

  function revealStatements(){
    document.querySelectorAll('.statement-line').forEach(function(el){
      if(el.getBoundingClientRect().top < window.innerHeight * 0.9){
        el.classList.add('revealed');
      }
    });
  }

  document.querySelectorAll('.statement-line').forEach(function(el, i){
    var span = el.querySelector('span');

    if(span){
      span.style.transitionDelay = (i * 0.12) + 's';
    }
  });

  window.addEventListener('scroll', revealStatements, {
    passive:true
  });

  revealStatements();

})();
</script>

