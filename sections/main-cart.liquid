{% assign current_language_prefix = localization.language.iso_code | split: '-' | first %}

<section style="max-width:900px;margin:0 auto;padding:120px 40px 80px;">

  <h1
    style="
      font-size:clamp(1.4rem,2.5vw,2rem);
      font-weight:300;
      letter-spacing:.18em;
      text-transform:uppercase;
      color:var(--text);
      margin-bottom:48px;
    "
  >
    {% if current_language_prefix == 'es' %}
      Tu carrito
    {% else %}
      Your Cart
    {% endif %}
  </h1>

  {%- if cart.item_count == 0 -%}

    <p
      style="
        color:var(--text-light);
        font-size:14px;
        letter-spacing:.08em;
      "
    >
      {% if current_language_prefix == 'es' %}
        Tu carrito está vacío.
      {% else %}
        Your cart is empty.
      {% endif %}
    </p>

    <a
      href="{{ routes.root_url }}"
      style="
        display:inline-block;
        margin-top:24px;
        font-size:11px;
        font-weight:500;
        letter-spacing:.28em;
        text-transform:uppercase;
        color:var(--text);
        text-decoration:none;
        border-bottom:1px solid currentColor;
      "
    >
      {% if current_language_prefix == 'es' %}
        Volver al inicio
      {% else %}
        Return to home
      {% endif %}
    </a>

  {%- else -%}

    {% form 'cart', cart %}

      <div style="border-top:1px solid var(--border);">

        {%- for item in cart.items -%}

          <div
            style="
              display:grid;
              grid-template-columns:80px 1fr auto;
              gap:24px;
              align-items:start;
              padding:28px 0;
              border-bottom:1px solid var(--border);
            "
          >

            <a href="{{ item.url }}">
              <img
                src="{{ item.image | img_url: '160x' }}"
                alt="{{ item.title | escape }}"
                style="
                  width:80px;
                  height:80px;
                  object-fit:cover;
                  border-radius:3px;
                "
              >
            </a>

            <div>

              <p
                style="
                  font-size:12px;
                  font-weight:500;
                  letter-spacing:.18em;
                  text-transform:uppercase;
                  color:var(--text);
                  margin:0 0 6px;
                "
              >
                {{ item.product.title }}
              </p>

              {%- unless item.variant.title == 'Default Title' -%}

                <p
                  style="
                    font-size:11px;
                    color:var(--text-muted);
                    letter-spacing:.1em;
                    margin:0 0 10px;
                  "
                >
                  {{ item.variant.title }}
                </p>

              {%- endunless -%}

             {%- for p in item.properties -%}

  {%- unless p.last == blank -%}

    {% assign property_label = p.first %}
    {% assign property_value = p.last %}

    {% assign property_label_normalized = p.first | strip | downcase %}
    {% assign property_value_normalized = p.last | strip | downcase %}

    {% if current_language_prefix != 'es' %}

      {% case property_label_normalized %}
        {% when 'saco interno' %}
          {% assign property_label = 'Velvet pouch' %}
        {% when 'saco de terciopelo' %}
          {% assign property_label = 'Velvet pouch' %}
        {% when 'plantilla' %}
          {% assign property_label = 'Template' %}
        {% when 'accesorios' %}
          {% assign property_label = 'Accessories' %}
      {% endcase %}

      {% case property_value_normalized %}
        {% when 'negro' %}
          {% assign property_value = 'Black' %}
        {% when 'blanco' %}
          {% assign property_value = 'White' %}
        {% when 'gris' %}
          {% assign property_value = 'Grey' %}
        {% when 'rojo' %}
          {% assign property_value = 'Red' %}
        {% when 'burdeos' %}
          {% assign property_value = 'Burgundy' %}
        {% when 'lila' %}
          {% assign property_value = 'Lilac' %}
      {% endcase %}

    {% endif %}

    <p
      style="
        font-size:11px;
        color:var(--text-light);
        margin:0 0 3px;
        letter-spacing:.06em;
      "
    >
      <span style="color:var(--text-muted);">
        {{ property_label }}:
      </span>

      {{ property_value }}
    </p>

  {%- endunless -%}

{%- endfor -%}

              <a
                href="{{ item.url_to_remove }}"
                style="
                  display:inline-block;
                  margin-top:12px;
                  font-size:10px;
                  letter-spacing:.22em;
                  text-transform:uppercase;
                  color:var(--text-muted);
                  text-decoration:none;
                  border-bottom:1px solid currentColor;
                "
              >
                {% if current_language_prefix == 'es' %}
                  Eliminar
                {% else %}
                  Remove
                {% endif %}
              </a>

            </div>

            <p
              style="
                font-size:15px;
                font-weight:300;
                color:var(--text);
                white-space:nowrap;
              "
            >
              {{ item.line_price | money }}
            </p>

          </div>

        {%- endfor -%}

      </div>

      <div
        style="
          margin-top:40px;
          display:flex;
          flex-direction:column;
          align-items:flex-end;
          gap:12px;
        "
      >

        <div
          style="
            display:flex;
            justify-content:space-between;
            width:100%;
            max-width:320px;
          "
        >

          <span
            style="
              font-size:11px;
              font-weight:500;
              letter-spacing:.28em;
              text-transform:uppercase;
              color:var(--text-muted);
            "
          >
            {% if current_language_prefix == 'es' %}
              Subtotal
            {% else %}
              Subtotal
            {% endif %}
          </span>

          <span
            style="
              font-size:16px;
              font-weight:300;
              color:var(--text);
            "
          >
            {{ cart.total_price | money }}
          </span>

        </div>

        <p
          style="
            font-size:11px;
            color:var(--text-muted);
            letter-spacing:.08em;
          "
        >
          {% if current_language_prefix == 'es' %}
            Impuestos y envío calculados al finalizar la compra.
          {% else %}
            Taxes and shipping calculated at checkout.
          {% endif %}
        </p>

        <button
          type="submit"
          name="checkout"
          class="btn-luxury btn-luxury-dark"
          style="margin-top:8px;padding:17px 56px;"
        >
          {% if current_language_prefix == 'es' %}
            Finalizar compra
          {% else %}
            Checkout
          {% endif %}
        </button>

      </div>

    {% endform %}

  {%- endif -%}

</section>

{% schema %}
{
  "name": "Cart",
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}