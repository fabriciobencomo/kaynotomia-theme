{%- comment -%}
  snippets/structured-data.liquid
  NUEVO — el tema no tenía ningún dato estructurado.

  Genera, según el tipo de página:
    · Organization  → solo en la home (identidad de marca / Knowledge Graph)
    · WebSite       → solo en la home
    · Product       → ficha de producto, con envío y política de devoluciones
    · BreadcrumbList→ producto, colección y artículo
    · Article       → artículos del blog

  Todos los valores dinámicos pasan por el filtro | json. Sin él, una comilla
  o un salto de línea en la descripción rompe el JSON entero y Google
  descarta TODO el marcado de la página.
{%- endcomment -%}

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: routes.root_url | json }},
    {%- if settings.favicon != blank %}
    "logo": {{ settings.favicon | image_url: width: 512 | prepend: "https:" | json }},
    {%- endif %}
    "description": {{ shop.description | default: page_description | strip_html | json }},
    "address": {
      "@type": "PostalAddress",
      "addressLocality": {{ settings.business_city | default: 'Madrid' | json }},
      {%- if settings.business_street != blank %}
      "streetAddress": {{ settings.business_street | json }},
      {%- endif %}
      {%- if settings.business_postal_code != blank %}
      "postalCode": {{ settings.business_postal_code | json }},
      {%- endif %}
      "addressCountry": {{ settings.business_country_code | default: 'ES' | json }}
    }
    {%- assign social_links = '' -%}
    {%- if settings.social_instagram != blank %}{%- assign social_links = social_links | append: settings.social_instagram | append: ',' %}{% endif -%}
    {%- if settings.social_tiktok != blank %}{%- assign social_links = social_links | append: settings.social_tiktok | append: ',' %}{% endif -%}
    {%- if settings.social_pinterest != blank %}{%- assign social_links = social_links | append: settings.social_pinterest | append: ',' %}{% endif -%}
    {%- if settings.social_youtube != blank %}{%- assign social_links = social_links | append: settings.social_youtube | append: ',' %}{% endif -%}
    {%- if settings.social_linkedin != blank %}{%- assign social_links = social_links | append: settings.social_linkedin | append: ',' %}{% endif -%}
    {%- assign social_array = social_links | split: ',' -%}
    {%- if social_array.size > 0 %},
    "sameAs": [{% for link in social_array %}{{ link | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
    {%- endif %}
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: routes.root_url | json }},
    "inLanguage": {{ localization.language.iso_code | json }}
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' and product != blank -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image %}
    "image": [
      {{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}
      {%- for media in product.media limit: 4 -%}
        {%- if media.media_type == 'image' and media.id != product.featured_image.id -%}
          , {{ media | image_url: width: 1200 | prepend: "https:" | json }}
        {%- endif -%}
      {%- endfor %}
    ],
    {%- endif %}
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    {%- if current_variant.sku != blank %}
    "sku": {{ current_variant.sku | json }},
    {%- endif %}
    {%- if current_variant.barcode != blank %}
    "gtin": {{ current_variant.barcode | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: shop.name | json }}
    },
    {%- if settings.product_material != blank %}
    "material": {{ settings.product_material | json }},
    {%- endif %}
    "offers": {
      "@type": "Offer",
      "url": {{ request.origin | append: product.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | divided_by: 100.0 | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": {{ settings.shipping_rate | default: 0 | json }},
          "currency": {{ cart.currency.iso_code | json }}
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": {{ settings.business_country_code | default: 'ES' | json }}
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 1, "maxValue": 2, "unitCode": "DAY"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": {{ settings.transit_days_min | default: 5 | json }},
            "maxValue": {{ settings.transit_days_max | default: 7 | json }},
            "unitCode": "DAY"
          }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": {{ settings.business_country_code | default: 'ES' | json }},
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": {{ settings.return_days | default: 14 | json }},
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumb.home' | t | json }},
        "item": {{ request.origin | append: routes.root_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
    ]
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumb.home' | t | json }},
        "item": {{ request.origin | append: routes.root_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      }
    ]
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'article' and article != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | truncate: 110 | json }},
    "articleBody": {{ article.content | strip_html | truncate: 1500 | json }},
    {%- if article.image %}
    "image": [{{ article.image | image_url: width: 1200 | prepend: "https:" | json }}],
    {%- endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Organization",
      "name": {{ article.author | default: shop.name | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
      {%- if settings.favicon != blank %},
      "logo": {
        "@type": "ImageObject",
        "url": {{ settings.favicon | image_url: width: 512 | prepend: "https:" | json }}
      }
      {%- endif %}
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: article.url | json }}
    },
    "inLanguage": {{ localization.language.iso_code | json }}
  }
  </script>
{%- endif -%}
