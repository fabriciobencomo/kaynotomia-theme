# Binarios pesados: NO versionar. Git conserva los blobs en el historial
# para siempre, aunque después se borren.
*.gif
*.mp4
*.mov
assets/*.psd
assets/*.ai
assets/*.sketch

# IMPORTANTE — no ignorar nunca estos:
#   config/settings_data.json   → Shopify lo sincroniza y es parte del tema
#   templates/*.json            → contienen el contenido del personalizador
